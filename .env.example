# ArXiv Research Publishing System - Environment Configuration
# Copy this file to .env and fill in your settings

# ============================
# ArXiv Configuration
# ============================
# Minimum number of papers to fetch before analysis
MIN_PAPERS_THRESHOLD=100

# Number of representative papers to select per topic
PAPERS_PER_TOPIC=5

# Default number of days to look back for papers
DEFAULT_DAYS_BACK=7

# Maximum papers an agent can fetch
MAX_PAPERS_PER_AGENT=500

# ============================
# Topic Modeling Configuration
# ============================
# Minimum number of papers required to form a topic
MIN_TOPIC_SIZE=5

# Maximum number of topics to extract
MAX_TOPICS=10

# Sentence transformer model for text embeddings
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================
# Directory Configuration
# ============================
# Directory for output files (one-pagers, reports)
OUTPUT_DIR=outputs

# Directory for data storage
DATA_DIR=data

# Directory for cached embeddings and other cached data
CACHE_DIR=data/cache

# Directory for downloaded PDF papers
PDF_DIR=data/pdfs

# ============================
# Processing Configuration
# ============================
# Batch size for embedding generation (adjust based on memory)
BATCH_SIZE=32

# Number of parallel workers for PDF downloads
MAX_WORKERS=4

# Delay between ArXiv API requests in seconds (respect rate limits)
REQUEST_DELAY=3.0

# ============================
# One-Pager Generation
# ============================
# Target word count for the one-pager
TARGET_WORD_COUNT=800

# Maximum papers to include in the one-pager summary
MAX_PAPERS_IN_SUMMARY=10

# ============================
# Logging Configuration
# ============================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=arxiv_editor.log

# Log format: json or text
LOG_FORMAT=json

# ============================
# LLM Configuration (Optional)
# ============================
# Use LLM for enhanced text generation and analysis
USE_LLM=false

# LLM provider: anthropic, openai
LLM_PROVIDER=anthropic # openai

# API key for the LLM provider
OPENAPI_KEY=xxxxxxxxxxxxxxx
ANTHROPIC_KEY=xxxxxxxxxxxx

# LLM model to use
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# OpenAI: gpt-4, gpt-3.5-turbo
LLM_MODEL=claude-3-5-sonnet-20241022

# ============================
# Agent Categories (Advanced)
# ============================
# These are configured in settings.py by default
# You can override them here if needed using JSON format:
# AGENT_CATEGORIES={"michel": ["math.HO", "math.GM"], ...}
